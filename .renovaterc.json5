{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>hydazz/renovate-config"],
  customManagers: [
    {
      customType: "regex",
      description: "ESPHome GitHub package and component pins",
      managerFilePatterns: ["/\\.ya?ml$/"],
      matchStrings: [
        "github://(?<depName>[^/\\s@]+/[^/\\s@]+)(?:/[^@\\s]+)?@(?<currentDigest>[a-f0-9]{40})",
      ],
      datasourceTemplate: "git-refs",
      packageNameTemplate: "https://github.com/{{{depName}}}",
      versioningTemplate: "exact",
    },
  ],
  packageRules: [
    {
      matchPackageNames: ["esphome"],
      automerge: false,
    },
    {
      matchDatasources: ["git-refs"],
      automerge: false,
    },
  ],
}
